EmailEvents
| where TimeGenerated > ago(30d)
| where EmailDirection == "Inbound"
| where IsFirstContact == true
| where tostring(DetectionMethods) has "Prompt Injection Protection"
| extend IP = iff(isnotempty(SenderIPv4), SenderIPv4, SenderIPv6)
| extend PromptInjector = strcat(SenderFromDomain, " ", IP)
| summarize AttackCount=count() by PromptInjector